# Maintainer: legendarylolo318-cloud <274669742+legendarylolo318-cloud@users.noreply.github.com>
pkgname=kickthefly-bin
_pkgname=kickthefly
pkgver=2.9.0
pkgrel=1
pkgdesc="Kick the Fly: a game running the MaleCNS v1.0 fruit fly connectome live, with Lab tools (prebuilt AppImage)"
arch=('x86_64')
url="https://github.com/legendarylolo318-cloud/kick-the-fly"
license=('MIT')
depends=('hicolor-icon-theme')
optdepends=('fuse3: run the AppImage mounted instead of extracting it each launch'
            'libglvnd: OpenGL 3.3 for the 3D game (falls back to 2D without it)'
            'pipewire-pulse: sound on PipeWire systems')
provides=("$_pkgname")
conflicts=("$_pkgname")
options=('!strip' '!debug')
source=("KickTheFly-x86_64-$pkgver.AppImage::$url/releases/download/v$pkgver/KickTheFly-x86_64.AppImage"
        "kickthefly.desktop"
        "kickthefly.png"
        "kickthefly.sh"
        "LICENSE")
noextract=("KickTheFly-x86_64-$pkgver.AppImage")
sha256sums=('21f351667ac450361642253aa5b795347cd16f4439dc7a9997ef1ba6f3b69e8e'
            '5955914a768e4e81389f93732c47c8b77fa4db1ddf7a68b0475d65df60bbf333'
            'ccf2cec7c35c6490e432860a2770435352a947a1d34c1a1db3426e5c096419d4'
            'f8792b58df71b2ca72f0f552a4f1a6a2327d2b9f7e24332d69c7a938801d22fe'
            '8707b0d197fdb224141f722831d872a54ae4b276a5b66b35f36007f997d6a115')

package() {
    install -Dm755 "KickTheFly-x86_64-$pkgver.AppImage" "$pkgdir/opt/$_pkgname/KickTheFly-x86_64.AppImage"
    install -Dm755 kickthefly.sh "$pkgdir/usr/bin/$_pkgname"
    install -Dm644 kickthefly.desktop "$pkgdir/usr/share/applications/$_pkgname.desktop"
    install -Dm644 kickthefly.png "$pkgdir/usr/share/icons/hicolor/256x256/apps/$_pkgname.png"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
